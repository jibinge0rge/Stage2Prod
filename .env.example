PORT=3000
GITHUB_TOKEN=ghp_xxx
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=automation-bot@example.com
JIRA_API_TOKEN=xxx
JIRA_JQL=project = PROJ AND status CHANGED AFTER -5m ORDER BY updated ASC
POLL_INTERVAL_MS=60000
API_TOKEN=local-dev-token
DRY_RUN=false
DB_PATH=./data/stage2prod.db
LOG_LEVEL=info
